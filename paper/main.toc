\contentsline {section}{\numberline {1}Introduction}{3}{section.1}%
\contentsline {subsection}{\numberline {1.1}Contributions}{4}{subsection.1.1}%
\contentsline {paragraph}{First, we provide the first close-election RD estimates of economic freedom effects on macroeconomic outcomes.}{4}{section*.2}%
\contentsline {paragraph}{Second, we implement a transparent specification search with pre-committed diagnostic thresholds.}{4}{section*.3}%
\contentsline {paragraph}{Third, we document the asymmetry in electoral effects and interpret it substantively.}{5}{section*.4}%
